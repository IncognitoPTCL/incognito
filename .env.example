# Copy to .env.local. Never commit .env.local.

# Solana RPC the server relays to (a paid one is faster than the public endpoint)
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Vercel Blob read-write token (public store). Used to host the coin image and
# metadata when pump.fun's own IPFS upload is refused (it is from the UK).
BLOB_READ_WRITE_TOKEN=

# Pinata JWT (app.pinata.cloud, free plan): pins the image + metadata to public IPFS
# when pump.fun refuses the upload. Tried before Blob.
PINATA_JWT=

# If set, the pad asks for this password before anything works.
PAD_PASSWORD=

# Priority fee PumpPortal adds to each launch, in SOL
LAUNCH_PRIORITY_FEE_SOL=0.0005
# Largest first buy the pad will build, in SOL
LAUNCH_MAX_BUY_SOL=20

PORT=4981
HOST=127.0.0.1
